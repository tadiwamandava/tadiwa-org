{
  "name": "tadiwa-org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:content": "node scripts/check-content.ts",
    "check:bundle": "node scripts/check-bundle.ts",
    "check": "npm run typecheck && npm run lint && npm run check:contrast && npm run check:content && npm run check:links && npm run check:search && npm run check:prompt && npm run check:admin && npm run check:bundle",
    "check:links": "node scripts/check-links.ts",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:search": "node scripts/build-embeddings.ts",
    "build:model": "bash scripts/copy-model.sh",
    "build:index": "npm run build:wasm && npm run build:search && npm run build:voice && npm run build:model",
    "test:rust": "cargo test --manifest-path crates/hnsw/Cargo.toml",
    "check:search": "node scripts/check-search.ts",
    "check:admin": "node src/lib/admin/selftest.ts",
    "test:nano": "bash engines/nano/build-test.sh",
    "build:fixtures": "bash engines/nano/tools/fixtures.sh",
    "test:nano:parity": "bash engines/nano/build-parity.sh",
    "build:nano": "bash engines/nano/build-wasm.sh",
    "nano": "bash engines/nano/run.sh",
    "test:nano:bpe": "bash engines/nano/build-bpe.sh",
    "test:nano:llama": "bash engines/nano/build-llama.sh",
    "chat": "bash engines/nano/chat.sh",
    "check:prompt": "node scripts/check-prompt.ts",
    "nano:data": "engines/nano/tools/.venv/bin/python engines/nano/tools/make_sft_data.py",
    "nano:train": "engines/nano/tools/.venv/bin/python engines/nano/tools/train_lora.py",
    "nano:merge": "engines/nano/tools/.venv/bin/python engines/nano/tools/merge_lora.py",
    "nano:eval": "engines/nano/tools/.venv/bin/python engines/nano/tools/eval_grounded.py",
    "build:voice": "node scripts/fetch-voice-model.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "gray-matter": "^4.0.3",
    "next": "16.3.1",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
