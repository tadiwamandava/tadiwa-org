# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Lighthouse CI reports (~40MB per local run)
/.lighthouseci/

# Self-hosted embedding weights (~22MB). Regenerate with 'npm run build:model'.
/public/models/
# wasm-pack output
/crates/*/pkg/
/crates/*/target/
/engines/nano/.build/
/engines/nano/tools/.venv/

# SmolLM2 weights. Neither is committed: the int8 file is 129 MB, which is over
# GitHub's 100 MiB per-file limit, and the fp32 file is 513 MB. Regenerate with
# engines/nano/tools/convert_smollm.py, or point the deployment at a host that
# serves them, see DEPLOY.md §5b.
/public/nano/smollm-fp32.bin
/public/nano/smollm-int8.bin

# The merged fine-tuned checkpoint (~540 MB fp32). Reproducible from the
# committed adapter: merge_lora.py, then convert_smollm.py.
/engines/nano/adapters/grounded-merged/
